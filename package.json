{
  "name": "vue-motion-sandbox",
  "version": "0.1.0",
  "private": false,
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "description": "A Vue 3 sandbox for experimenting with motion effects, animations, and interactive web experiences using modern libraries like GSAP, Three.js, Lottie, and more",
  "keywords": [
    "vue3",
    "effects",
    "animations",
    "gsap",
    "threejs",
    "lottie",
    "interactive",
    "sandbox",
    "vite"
  ],
  "author": "tessOu56",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@github.com:tessOu56/vue-motion-sandbox.git"
  },
  "homepage": "https://tessou56.github.io/vue-motion-sandbox/",
  "scripts": {
    "dev": "vite",
    "serve": "vite",
    "build": "vite build && node scripts/postbuild-pages.mjs",
    "preview": "vite preview",
    "lint": "eslint --ext .js,.vue src vite.config.js vitest.config.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tweenjs/tween.js": "^25.0.0",
    "@vueuse/core": "^13.9.0",
    "@vueuse/motion": "^3.0.3",
    "gsap": "^3.15.0",
    "lottie-web": "^5.13.0",
    "three": "^0.186.0",
    "vue": "^3.5.42",
    "vue-router": "^4.6.4",
    "pinia": "^3.0.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.5.2",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.32.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ]
}
